global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'ubuntu-server'
    static_configs:
      - targets: ['{{ hostvars[groups["ubuntu_server"][0]].ansible_host | default(groups["ubuntu_server"][0]) }}:9100', '{{ hostvars[groups["ubuntu_server"][0]].ansible_host | default(groups["ubuntu_server"][0]) }}:8080']

  - job_name: 'hp-node'
    static_configs:
      - targets: ['{{ hostvars[groups["hp_observability"][0]].ansible_host | default(groups["hp_observability"][0]) }}:9100']

  - job_name: 'toshiba-edge'
    static_configs:
      - targets: ['{{ hostvars[groups["toshiba_edge"][0]].ansible_host | default(groups["toshiba_edge"][0]) }}:9100']

  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
